# Generic command wiring (cmd/voice-pipeline)
PIPELINE_SESSION_ID=voice-session
PIPELINE_SYSTEM_PROMPT=You are a concise voice assistant. Reply in one or two short sentences.
PIPELINE_AUDIO_SOURCE=mic
# PIPELINE_AUDIO_SOURCE=websocket requires this URL.
PIPELINE_AUDIO_SOURCE_URL=
PIPELINE_PLAYBACK_SINK=portaudio
# PIPELINE_PLAYBACK_SINK=websocket requires this URL.
PIPELINE_PLAYBACK_URL=
PIPELINE_SPEECH_START_MS=80
PIPELINE_SPEECH_END_MS=400
PIPELINE_STABLE_REPEATS=2
PIPELINE_PHRASE_MIN_CHARS=24
PIPELINE_MAX_CONVERSATION_MESSAGES=8
PIPELINE_MAX_TURN_AUDIO_BUFFER=32
PIPELINE_MAX_TOKENS=120
PIPELINE_TEMPERATURE=0.2

# Voice activity detection
PIPELINE_VAD_PROVIDER=silero
SILERO_MODEL_PATH=C:\path\to\silero_vad.onnx
PIPELINE_ENERGY_VAD_THRESHOLD=0.04
PIPELINE_PYTHON_EXE=python
PIPELINE_VAD_PYTHON_EXE=
PIPELINE_SILERO_THRESHOLD=0.5

# Speech-to-text and language model
PIPELINE_STT_PROVIDER=python-mistral
PIPELINE_STT_PYTHON_EXE=
MISTRAL_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
VOXTRAL_REALTIME_URL=
VOXTRAL_TARGET_STREAMING_DELAY_MS=0
VOXTRAL_MODEL=voxtral-mini-transcribe-realtime-2602
MISTRAL_LLM_MODEL=mistral-small-latest

# Text-to-speech
CARTESIA_API_KEY=
CARTESIA_VERSION=2025-04-16
CARTESIA_VOICE_ID=
CARTESIA_LANGUAGE=en
CARTESIA_MODEL_ID=sonic-3
